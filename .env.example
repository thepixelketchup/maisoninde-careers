# Resend (resend.com): verify the maisoninde.com domain so mail can send from careers@maisoninde.com
RESEND_API_KEY=re_xxx
MAIL_FROM=Maison Indē Careers <careers@maisoninde.com>

# Who receives applications. Comma-separate multiple people.
NOTIFY_TO_NL=careers@maisoninde.com
NOTIFY_TO_IN=careers@maisoninde.com

# Set to "false" to stop sending the applicant a copy
SEND_CONFIRMATION=true
